{
    "groups": {
        // the current it lead, update at handoff
        "group:it": ["erics118@github"],
    },

    "grants": [
        // every member and tagged device reaches every device and service
        {
            "src": ["*"],
            "dst": ["*"],
            "ip":  ["*"],
        },
    ],

    "ssh": [
        // members ssh into their own devices and every tagged device
        {
            "src":    ["autogroup:member"],
            "dst":    ["autogroup:self", "autogroup:tagged"],
            "users":  ["autogroup:nonroot", "root"],
            "action": "accept",
        },
        // tagged devices ssh into each other
        {
            "src":    ["autogroup:tagged"],
            "dst":    ["autogroup:tagged"],
            "users":  ["autogroup:nonroot", "root"],
            "action": "accept",
        },
    ],

    "tagOwners": {
        // general purpose devices, this tag just allows you to ssh into it
        "tag:general": [],
    },

    "tests": [
        {
            "src":    "group:it",
            "accept": ["tag:general:22"],
        },
        {
            "src":    "tag:general",
            "accept": ["tag:general:22", "svc:cev-evil:80", "svc:cev-cat:80", "svc:cev-data:80"],
        },
    ],

    "sshTests": [
        {
            "src":    "group:it",
            "dst":    ["tag:general"],
            "accept": ["cev", "root"],
        },
        {
            "src":    "tag:general",
            "dst":    ["tag:general"],
            "accept": ["cev"],
        },
    ],
}
